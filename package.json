{
  "name": "feathers-authentication-oidc",
  "version": "0.5.0",
  "description": "OIDC Authentication for FeathersJS.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "tsc --strict false -p .",
    "build:watch": "tsc -p . --watch",
    "test": "pnpm run build && pnpm run mocha",
    "mocha": "mocha --recursive test/**/*.test.ts --exit",
    "mocha:watch": "mocha --watch --recursive test/**/*.test.ts",
    "release": "rm -rf lib && pnpm run build && standard-version release"
  },
  "repository": "github:deskoh/feathers-authentication-oidc.git",
  "keywords": [
    "feathers",
    "feathersjs",
    "oidc"
  ],
  "author": "deskoh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/deskoh/feathers-authentication-oidc/issues"
  },
  "homepage": "https://github.com/deskoh/feathers-authentication-oidc",
  "peerDependencies": {
    "@feathersjs/authentication": "^5.0.46",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0"
  },
  "devDependencies": {
    "@feathersjs/authentication": "^5.0.46",
    "@feathersjs/errors": "^5.0.46",
    "@feathersjs/express": "^5.0.46",
    "@feathersjs/feathers": "^5.0.46",
    "@feathersjs/memory": "^5.0.46",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.12.4",
    "jws": "^4.0.1",
    "mocha": "^11.7.6",
    "pem-jwk": "^2.0.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "jose": "^6.2.3"
  }
}
