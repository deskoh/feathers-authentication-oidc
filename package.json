{
  "name": "feathers-authentication-oidc",
  "version": "0.4.5",
  "description": "OIDC Authentication for FeathersJS.",
  "main": "lib/",
  "engines": {
    "node": ">= 20.0.0"
  },
  "scripts": {
    "build": "tsgo --strict false -p .",
    "build:watch": "tsc -p . --watch",
    "test": "npm run build && npm run mocha",
    "mocha": "mocha --recursive test/**/*.test.ts --exit",
    "mocha:watch": "mocha --watch --recursive test/**/*.test.ts",
    "release": "rm -rf lib && npm run build && standard-version release"
  },
  "repository": "github:deskoh/feathers-authentication-oidc.git",
  "keywords": [
    "feathers",
    "feathersjs",
    "oidc"
  ],
  "author": "deskoh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/deskoh/feathers-authentication-oidc/issues"
  },
  "homepage": "https://github.com/deskoh/feathers-authentication-oidc",
  "devDependencies": {
    "@feathersjs/authentication": "^4.5.19",
    "@feathersjs/express": "^4.5.19",
    "@types/debug": "^4.1.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "crypto": "^1.0.1",
    "feathers-memory": "^4.1.0",
    "jws": "^4.0.1",
    "mocha": "^11.7.6",
    "pem-jwk": "^2.0.0",
    "source-map-support": "^0.5.21",
    "tsx": "^4.22.3"
  },
  "dependencies": {
    "@feathersjs/errors": "^4.5.19",
    "axios": "^1.16.1",
    "debug": "^4.4.3",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1"
  }
}
